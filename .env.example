# =================================
# Agent PoC Template - Environment Variables
# =================================

# Application
ENVIRONMENT=development
DEBUG=true

# OpenRouter AI Configuration (required for AI features)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Site URL for OpenRouter headers
SITE_URL=http://localhost:8000
SITE_NAME=Agent PoC Template

# Database (SQLite - automatically created)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=["application/pdf","image/png","image/jpeg","text/plain"]

# Frontend
VITE_API_URL=http://localhost:8000/api
